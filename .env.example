# Z.ai API platform key (free tier — glm-4.7-flash costs $0)
# Create one at https://z.ai/model-api -> API Keys
ZAI_API_KEY=your_free_zai_api_key_here

# Optional overrides
ZAI_MODEL=glm-4.7-flash
ZAI_THINKING=disabled

# ── Provider switching (all OpenAI-compatible; NO code changes needed) ──
# Pool keys (ZAI_API_KEY / ZAI_API_KEY_2..9) call ZAI_API_URL with ZAI_MODEL_POOL.
# Student personal keys (BYOK) ALWAYS go to Z.ai first-party with ZAI_MODEL,
# regardless of where the pool points.
#
# Default (Z.ai first-party):
#   ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions
#
# OpenRouter example (model slug needs the vendor prefix):
#   ZAI_API_URL=https://openrouter.ai/api/v1/chat/completions
#   ZAI_MODEL_POOL=z-ai/glm-5.3-flash
#
# Throughput guardrail: paid tier with high concurrency should also raise:
#   ZAI_CONCURRENCY=50    # in-flight cap (defaults to number of pool keys)

# Rate governor (deterministic pacing in front of the free tier)
ZAI_RPM_LIMIT=12        # max upstream requests per rolling 60s window
ZAI_MIN_GAP_MS=2000     # minimum gap between request starts
